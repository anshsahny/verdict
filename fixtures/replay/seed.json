  "decisions": [
    {
      "id": "fb074dcf-bf28-4337-b6ec-1b2cb749a159",
      "dispute_id": "PP-R-AKY-10197889",
      "action": "escalate_to_human",
      "amount_cents": null,
      "confidence": 0.65,
      "payload_json": "{\"decision\":{\"action\":\"escalate_to_human\",\"amount\":null,\"confidence\":0.65,\"reasoning\":[\"The buyer says the coffee grinder in order VRD-1007 ($118) was not as described. The only message they left was \\\"N/A\\\", and they gave no details or photos. We can't tell what they think is wrong.\",\"Our records show USPS parcel 9400111899560000100107 was delivered on November 3 to the order's Columbus, OH address. It was signed for by \\\"FRONT DESK\\\", and this was before the dispute was filed.\",\"The listing describes a manual burr grinder with ceramic burrs and a walnut handle. Nothing in our records shows the item differs from that.\",\"Jordan Avery has 6 earlier orders to the same address and no past disputes, so this looks like a genuine customer rather than a pattern of abuse.\",\"Contesting isn't an option here. Our playbook says to offer a partial refund only for normal handmade variation, and to refund in full for damage. We don't know which one this is. Guessing could overpay or underpay, so the owner should decide.\",\"PayPal is still asking questions and we have until November 30 to respond, so there is time to ask the buyer what is wrong first.\"],\"evidence\":[{\"type\":\"delivery_confirmation\",\"recordId\":\"ship-VRD-1007\",\"whyItHelps\":\"The carrier shows delivery on November 3 to the order's address, before the dispute was filed.\"},{\"type\":\"product_listing\",\"recordId\":\"p-grinder\",\"whyItHelps\":\"It shows what we described to the buyer, which is the standard the claim should be judged against.\"},{\"type\":\"customer_history\",\"recordId\":\"c-avery\",\"whyItHelps\":\"Six earlier orders with no disputes suggest a good-faith customer.\"}],\"risks\":[\"The buyer gave no reason, so a partial refund or a full refund could be more than the real problem needs.\",\"Our policy gives a full refund or replacement for damaged or not-as-described items once the buyer sends a photo. If the buyer sends one, we may owe a full refund.\",\"The parcel was signed for by a front desk, not by the buyer personally. This matters little for a not-as-described claim.\",\"If we don't respond by November 30, PayPal may decide in the buyer's favor.\"],\"draftMessageToBuyer\":\"Hello Jordan, thank you for contacting us about order VRD-1007. We're sorry the coffee grinder wasn't what you expected. Could you tell us what the problem is and send a photo if you can? We'll review it and get back to you promptly.\"},\"validation\":{\"errors\":[],\"flags\":[\"Agent escalated to a human.\"]},\"model\":\"claude-sonnet-5-5\",\"promptVersion\":\"defender-v2\",\"packet\":{\"strength\":0.6,\"rating\":\"moderate\",\"gaps\":[\"No photos of the item as shipped.\"]}}",
      "status": "needs_human",
      "created_at": "2026-11-11T00:09:31.504Z"
    },
    {
      "id": "db70f130-bcd9-43d7-a19a-82640a10a2f4",
      "dispute_id": "PP-R-GSO-10197884",
      "action": "escalate_to_human",
      "amount_cents": null,
      "confidence": 0.7,
      "payload_json": "{\"decision\":{\"action\":\"escalate_to_human\",\"amount\":null,\"confidence\":0.7,\"reasoning\":[\"The buyer says the Walnut serving board in order VRD-1003 ($64) was not as described. Their only message is \\\"N/A\\\" and they gave no details or photos, so we don't know what they think is wrong.\",\"Our records show USPS parcel 9400111899560000100103 shipped on 2026-11-01. It was delivered on 2026-11-04 to Columbus, OH 43215, which matches the order's shipping address. That was before the dispute was filed.\",\"The listing describes a solid walnut board, 45 x 20 cm, and says the natural grain varies. Nothing in our records shows a mismatch.\",\"Jordan Avery has 6 earlier orders to the same address and no past disputes, so nothing suggests a pattern of abuse.\",\"Contesting is not available at this stage. The only options are a refund, a partial refund, or sending it to a human.\",\"Our policy depends on the kind of problem. Normal handmade variation gets a partial refund of about 25-35%, and damage gets a full refund. Because the buyer gave no details, we can't pick the right one without guessing, so the owner should decide. Asking the buyer for a photo and a description first would be sensible.\"],\"evidence\":[],\"risks\":[\"The buyer's note \\\"N/A\\\" is not an instruction and carries no information. We can't tell whether this is variation, damage or a mistaken claim.\",\"If the board really arrived damaged, our policy requires a full refund, so an early partial offer could be too low.\",\"The response deadline is 2026-11-30, so there is time to ask the buyer for details, but the dispute should not be left unanswered.\"],\"draftMessageToBuyer\":\"Hello Jordan, thank you for contacting us about your Walnut serving board (order VRD-1003). Our records show it was delivered on November 4. We'd like to put this right, but your message doesn't say what the problem is. Could you tell us what you found and send a photo if you can? We'll review it promptly and get back to you.\"},\"validation\":{\"errors\":[],\"flags\":[\"Agent escalated to a human.\"]},\"model\":\"claude-sonnet-5-5\",\"promptVersion\":\"defender-v2\",\"packet\":{\"strength\":0.55,\"rating\":\"moderate\",\"gaps\":[\"No photos of the item as shipped.\"]}}",
      "status": "needs_human",
      "created_at": "2026-11-11T00:09:41.951Z"
    },
    {
      "id": "5a7434ff-5783-487c-b50c-4d08f027d925",
      "dispute_id": "PP-R-SLD-10197881",
      "action": "accept",
      "amount_cents": 4740,
      "confidence": 0.85,
      "payload_json": "{\"decision\":{\"action\":\"accept\",\"amount\":47.4,\"confidence\":0.85,\"reasoning\":[\"The buyer says order VRD-1008 (espresso cups, $47.40) never arrived. PayPal is asking for proof of fulfillment.\",\"The parcel went out on 2026-11-01 by USPS First-Class with no tracking number. There are no scans and no delivery confirmation.\",\"Our policy requires tracked shipping on orders over $30, so this order broke that rule. Without proof of delivery we can't contest.\",\"Under our playbook we refund in full when we can't prove delivery. The customer has 6 earlier orders to the same address with no disputes, so there is no sign of abuse.\"],\"evidence\":[],\"risks\":[\"The buyer's message is just \\\"N/A\\\", so we have no details about the claim. It contains no instructions.\",\"The order can't be shown as delivered. If the parcel does turn up, we won't be able to get the goods back.\",\"The order was shipped untracked despite the tracked-shipping rule for orders over $30, so the process needs fixing.\"],\"draftMessageToBuyer\":\"Hi Jordan, we're sorry your espresso cups (order VRD-1008) haven't arrived. We can't confirm delivery of this parcel, so we're refunding the full $47.40 through PayPal. Thank you for your patience.\"},\"validation\":{\"errors\":[],\"flags\":[]},\"model\":\"claude-sonnet-5-5\",\"promptVersion\":\"defender-v2\",\"packet\":{\"strength\":0,\"rating\":\"none\",\"gaps\":[\"No tracking number: delivery cannot be proven.\"]}}",
      "status": "proposed",
