# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: a second sandbox app for buyer-side calls. Not needed: buyer actions use PayPal-Auth-Assertion.
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=

# Id returned when the sandbox webhook is registered (POST /v1/notifications/webhooks)
PAYPAL_WEBHOOK_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# AG Studio licence key (the app runs unlicensed without it, with a watermark)
AG_STUDIO_LICENSE_KEY=

APP_BASE_URL=http://localhost:3000
